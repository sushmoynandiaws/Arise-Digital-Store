+        if len(offers) > 100:
+            raise HTTPException(422, "Use at most 100 offers per shop")
+    elif req.remove_code:
+        offers = [item for item in current if offer_code(item) != req.remove_code]
+    else:
+        if req.enabled is None:
+            raise HTTPException(422, "Choose the offer's active state")
+        offers = [{**item, "active": req.enabled, "is_active": req.enabled, "enabled": req.enabled}
+            if offer_code(item) == req.active_code else item for item in current]
+    business.settings_data = {**(business.settings_data or {}), "coupons": offers}
+    await db.commit()
+    return offers_response(offers)
