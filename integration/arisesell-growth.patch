+"""Store-owned scheduled offers shared by marketplace and source checkout."""
+from datetime import datetime
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+import re
+
+from fastapi import HTTPException
+
+from app.services.digital_inventory import utc, utcnow
+
+
+def offers_for(settings):
+    if isinstance(settings.get("coupons"), list):
+        return settings["coupons"]
+    code = next((settings[key] for key in ("coupon_code", "couponCode", "active_coupon", "activeCoupon") if settings.get(key)), None)
+    if not code:
+        return []
+    benefit = next((settings[key] for key in ("coupon_benefit", "couponBenefit", "discount_rate", "discountRate") if settings.get(key)), "")
+    minimum = next((settings[key] for key in ("coupon_min_spend", "couponMinSpend", "min_order_amount", "minOrderAmount") if settings.get(key)), "0")
+    return [{"code": str(code).strip().upper(), "benefit": str(benefit), "min_spend": str(minimum)}]
+
+
+def offer_code(offer):
+    return str(offer.get("code") or offer.get("coupon_code") or offer.get("couponCode") or "").strip().upper()
+
+
+def active_offer(offer):
+    if not isinstance(offer, dict) or any(offer.get(key) is False for key in ("active", "is_active", "enabled")):
+        return False
+    try:
+        start = offer.get("starts_at")
+        end = offer.get("expires_at")
+        return (not start or utc(datetime.fromisoformat(str(start).replace("Z", "+00:00"))) <= utcnow()) and (
+            not end or utcnow() < utc(datetime.fromisoformat(str(end).replace("Z", "+00:00"))))
+    except (ValueError, TypeError):
+        return False
+
+
+def coupon_discount(settings, subtotal, code, *, product_ids=()):
+    code = str(code or "").strip().upper()
+    for offer in offers_for(settings):
+        if not active_offer(offer) or offer_code(offer) != code:
+            continue
+        allowed = offer.get("product_ids") or []
+        if allowed and (not product_ids or not set(map(str, product_ids)).issubset(set(allowed))):
+            raise HTTPException(409, "This offer does not apply to every item in this order")
+        try:
+            minimum = re.search(r"\d+(?:\.\d+)?", str(offer.get("min_spend") or offer.get("minSpend") or offer.get("coupon_min_spend") or "0").replace(",", ""))
+            benefit = str(offer.get("benefit") or offer.get("coupon_benefit") or offer.get("discount") or "").replace(",", "")
+            number = re.search(r"\d+(?:\.\d+)?", benefit)
+            if not number or not minimum:
+                break
+            value = Decimal(number.group())
+            if subtotal < Decimal(minimum.group()):
+                raise HTTPException(409, "This order does not meet the coupon's minimum spend")
+            if value <= 0 or ("%" in benefit and value > 100):
+                break
+            saving = subtotal * value / 100 if "%" in benefit else value
+            return code, min(subtotal, saving).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+        except InvalidOperation:
+            break
+    raise HTTPException(409, "Invalid, inactive or expired coupon code")
+
+
+def public_offers(business):
+    result = []
+    for offer in offers_for(business.settings_data or {}):
+        if not active_offer(offer) or not offer.get("flash"):
+            continue
+        result.append({key: offer.get(key) for key in (
+            "code", "benefit", "min_spend", "starts_at", "expires_at", "product_ids", "title")})
+    return result
