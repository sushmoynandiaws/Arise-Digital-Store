+        products = set(await db.scalars(select(Product.id).where(Product.business_id == business.id)))
+        try:
+            start, end = (utc(datetime.fromisoformat(value.replace("Z", "+00:00"))) for value in (offer.starts_at, offer.expires_at))
+        except (ValueError, TypeError):
+            raise HTTPException(422, "Choose valid offer dates") from None
+        if end <= start or not set(offer.product_ids).issubset(products):
+            raise HTTPException(422, "Check offer dates and products belonging to this shop")
+        value = Decimal(offer.benefit.rstrip("%"))
+        if value <= 0 or (offer.benefit.endswith("%") and value >= 100):
+            raise HTTPException(422, "Use a positive discount below 100 percent")
+        offers = [item for item in current if offer_code(item) != offer.code]
