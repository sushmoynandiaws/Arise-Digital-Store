+    sales.business.settings_data={**sales.business.settings_data,"marketplace_listing":{**sales.business.settings_data["marketplace_listing"],"product_ids":[str(sales.product.id),str(product.id)]}}
+    await sales.db.commit()
+    req={**request(sales,"bkash"),"buyer":{**request(sales)["buyer"],"email":"buyer@example.com"},
+        "items":[lines(sales,variant)[0],{"product_id":str(product.id),"variant_id":str(variant.id),"quantity":1}]}
+    quoted=await market_api.post("/api/v1/marketplace/checkout/quote",json=req)
+    assert quoted.status_code==200,quoted.text
+    assert quoted.json()["snapshot"]["digital_config"]["delivery_mode"]=="manual"
+    result=await accept(market_api,req,quoted.json())
+    assert result.status_code==200,result.text
+    order=await sales.db.get(Order,uuid.UUID(result.json()["id"]))
+    assert (await market_api.post(f"/api/v1/marketplace/orders/{order.id}/reveal")).status_code==409
+    await pay(sales,order)
+    partial=(await market_api.get(f"/api/v1/marketplace/orders/{order.id}")).json()
+    assert partial["ready"] and partial["ready_quantity"]==1
+    automatic=await market_api.post(f"/api/v1/marketplace/orders/{order.id}/reveal")
+    assert automatic.status_code==200,automatic.text
+    assert len(automatic.json()["items"])==1 and "PRIVATE-LICENSE" in automatic.text
+    manual=next(unit for unit in await checkout.units_for(sales.db,order) if unit.mode=="manual")
+    await delivery.prepare_delivery(sales.db,sales.business,order,PrepareRequest(idempotency_key="cart-manual-prepare",
+        units=[{"fulfilment_id":manual.id,"content":"PRIVATE-MANUAL-COURSE"}]),sales.owner.id)
+    await delivery.queue_delivery(sales.db,sales.business,order,actor=sales.owner.id,key="cart-manual-send")
+    await sales.db.commit()
+    revealed=await market_api.post(f"/api/v1/marketplace/orders/{order.id}/reveal")
+    assert revealed.status_code==200,revealed.text
+    assert len(revealed.json()["items"])==2
+    assert {item["item"] for item in revealed.json()["items"]}=={1,2}
+    assert {item["name"] for item in revealed.json()["items"]}=={sales.product.name,product.name}
+    assert "PRIVATE-LICENSE" in revealed.text and "PRIVATE-MANUAL-COURSE" in revealed.text
+    assert (await market_api.post(f"/api/v1/marketplace/orders/{order.id}/reveal",headers={"X-Marketplace-Buyer":"b"*64})).status_code==404
