+            await db.rollback()
+            return {"state":"unavailable", "matches":[]}
+        result = await find(db, req, products, evidence, business=business)
+        if result["state"] == "unavailable":
+            await db.rollback()
+        else:
+            await db.commit()
+        return result
+    except BaseException:
