+"""Real scratch-local image files follow their database transaction, not the request's happy path."""
+import asyncio
+import threading
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+from sqlalchemy import func, select
+
+from app.core.config import settings
+from app.models.product_image import ImageAsset
+from app.services import product_images
+from tests.test_product_image_reply import photo_commerce, image_bytes
+from tests.test_whatsapp_commerce import commerce
+
+
+@pytest.fixture
+async def uploads(photo_commerce, tmp_path, monkeypatch):
+    db, business, *_ = photo_commerce
+    monkeypatch.setattr(settings, "PRODUCT_IMAGE_DIR", str(tmp_path))
+    monkeypatch.setattr(settings, "PRODUCT_IMAGE_STORAGE", "local")
+    return SimpleNamespace(db=db, root=tmp_path, user=SimpleNamespace(id=business.id, business_id=business.id))
+
+
+def files(a):
+    return {str(p.relative_to(a.root)) for p in a.root.rglob("*") if p.is_file()}
+
+
+@pytest.mark.parametrize("end", ["rollback", "close"])
+async def test_uncommitted_upload_is_deleted_on_transaction_end(uploads, end):
+    a = uploads
+    before = await a.db.scalar(select(func.count()).select_from(ImageAsset))
+    await product_images.store_upload(a.db, a.user, image_bytes(), commit=False)
+    assert len(files(a)) == 2
+    await getattr(a.db, end)()
+    assert not files(a)
+    assert await a.db.scalar(select(func.count()).select_from(ImageAsset)) == before
+    assert product_images.PENDING_UPLOADS not in a.db.info
+
+
+async def test_savepoint_rollback_keeps_outer_upload_and_commit_keeps_it(uploads):
+    a = uploads
+    await product_images.store_upload(a.db, a.user, image_bytes(), commit=False)
+    outer = files(a)
+    with pytest.raises(ValueError):
+        async with a.db.begin_nested():
+            await product_images.store_upload(a.db, a.user, image_bytes(), commit=False)
+            assert len(files(a)) == 4
+            raise ValueError("Reject only this savepoint")
+    assert files(a) == outer
+    await a.db.commit()
+    await a.db.rollback()
+    assert files(a) == outer
+    assert product_images.PENDING_UPLOADS not in a.db.info
+
+
+async def test_released_savepoint_uploads_are_deleted_by_outer_rollback(uploads):
+    a = uploads
+    await product_images.store_upload(a.db, a.user, image_bytes(), commit=False)
+    async with a.db.begin_nested():
+        await product_images.store_upload(a.db, a.user, image_bytes(), commit=False)
+    assert len(files(a)) == 4
+    await a.db.rollback()
+    assert not files(a)
+
+
+async def test_committed_and_deduplicated_uploads_are_not_deleted(uploads):
+    a = uploads
+    asset = await product_images.store_upload(a.db, a.user, image_bytes())
+    asset_id, retained = asset.id, files(a)
+    reused = await product_images.store_upload(a.db, a.user, image_bytes(), commit=False, deduplicate=True)
+    assert reused.id == asset_id
+    await a.db.rollback()
+    assert files(a) == retained and len(retained) == 2
+    assert await a.db.get(ImageAsset, asset_id) is not None
+
+
+async def test_error_after_completed_commit_does_not_delete_committed_files(uploads, monkeypatch):
+    a = uploads
+    commit = a.db.commit
+    async def committed_then_failed():
+        await commit()
+        raise RuntimeError("Fixture post-commit failure")
+    monkeypatch.setattr(a.db, "commit", committed_then_failed)
+    with pytest.raises(HTTPException):
+        await product_images.store_upload(a.db, a.user, image_bytes())
+    assert len(files(a)) == 2
+    assert product_images.PENDING_UPLOADS not in a.db.info
+
+
+async def test_later_storage_failure_cleans_its_files_then_outer_rollback_cleans_earlier_upload(uploads, monkeypatch):
+    a = uploads
+    await product_images.store_upload(a.db, a.user, image_bytes(), commit=False)
+    outer = files(a)
+    store = product_images._store
+    def failed(*args):
+        store(*args)
+        raise OSError("Fixture storage failure")
+    monkeypatch.setattr(product_images, "_store", failed)
+    with pytest.raises(HTTPException):
+        await product_images.store_upload(a.db, a.user, image_bytes(), commit=False)
+    assert files(a) == outer
+    await a.db.rollback()
+    assert not files(a)
+
+
+async def test_cancelled_write_finishes_before_cleanup_even_with_repeated_cancellation(uploads, monkeypatch):
+    a = uploads
+    started, release, finished = threading.Event(), threading.Event(), threading.Event()
+    store = product_images._store
+    def delayed(*args):
+        started.set()
+        assert release.wait(3)
+        try:
+            store(*args)
+        finally:
+            finished.set()
+    monkeypatch.setattr(product_images, "_store", delayed)
+    task = asyncio.create_task(product_images.store_upload(a.db, a.user, image_bytes(), commit=False))
+    try:
+        assert await asyncio.to_thread(started.wait, 3)
+        task.cancel()
+        await asyncio.sleep(0)
+        task.cancel()
+        await asyncio.sleep(0)
+        release.set()
+        with pytest.raises(asyncio.CancelledError):
+            await asyncio.wait_for(task, 3)
+        assert finished.is_set() and not files(a)
+        await a.db.rollback()
+        assert not files(a)
+    finally:
+        release.set()
+        await asyncio.gather(task, return_exceptions=True)
