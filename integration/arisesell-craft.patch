+"""No live models, customer messages or order writes in finder evaluation."""
+import json
+from types import SimpleNamespace
+from decimal import Decimal
+from unittest.mock import AsyncMock
+
+import pytest
+from sqlalchemy import select, func
+from app.models.order import Order
+from app.models.product import Product, Variant
+from app.services.marketplace_assistant import SearchIntent, select_products, budget
+from tests.test_marketplace import market_api, physical_shop, digital_engine, sales
+
+
+PRODUCTS = [{"id":"shoe","currency":"BDT","name":"Office sneaker","category":"Shoes","description":"White canvas shoe", "variants":[
+    {"id":"white42","name":"White 42","size":"42","color":"White","price":"1450.50","stock":3},
+    {"id":"black42","name":"Black 42","size":"42","color":"Black","price":"1600","stock":2},
+    {"id":"white41","name":"White 41","size":"41","color":"White","price":"1200","stock":0}]}]
+
+
+def test_bangla_budget_size_color_stock_and_exact_variant_evidence():
+    query="১৫০০ টাকার মধ্যে সাদা জুতা সাইজ ৪২"
+    intent=SearchIntent(intent="search",groups=[["জুতা","shoe"]],max_budget="১৫০০",size_text="৪২",color_text="সাদা")
+    assert select_products(intent,PRODUCTS,[query]) == [{"product_id":"shoe","variant_ids":["white42"]}]
+    assert not select_products(intent,PRODUCTS,[query],selected_id="another-shop-product")
+    assert not select_products(intent.model_copy(update={"max_budget":"০"}),PRODUCTS,[query+" বাজেট ০"])
+    with pytest.raises(ValueError):
+        select_products(intent.model_copy(update={"max_budget":"500"}),PRODUCTS,[query])
+    with pytest.raises(ValueError):
+        select_products(intent,PRODUCTS,[query+" usd"])
+
+
+def test_banglish_budget_correction_and_no_random_gifts():
+    assert budget("দেড় হাজার", ["দেড় হাজার টাকার জুতা"])==1500
+    assert budget("পনেরোশো", ["পনেরোশো টাকার জুতা"])==1500
+    intent=SearchIntent(intent="search",groups=[["shoe","juta"]],max_budget="1.5k")
+    assert select_products(intent,PRODUCTS,["budget 2000 juta", "akhon 1.5k er moddhe"])[0]["variant_ids"]==["white42"]
+    assert select_products(SearchIntent(intent="search"),PRODUCTS,["gift chai"])==[]
+    assert select_products(SearchIntent(intent="search",size_text="42"),PRODUCTS,["size 42"],"shoe")[0]["variant_ids"]==["white42","black42"]
+
+
+async def test_source_search_only_returns_published_allowlisted_in_stock_variants(market_api, physical_shop, monkeypatch):
+    from app.services import ai_gateway
+    s=physical_shop
+    s.product.name="Office sneaker"
+    s.product.category="Shoes"
+    s.variant.price=Decimal("1450.50");s.variant.size="42";s.variant.color="White";s.variant.stock=3
+    hidden=Product(business_id=s.business.id,name="Secret shoe",category="Shoes",price=100,image_url="",fulfilment_kind="physical")
+    s.db.add(hidden);await s.db.commit()
+    gateway=AsyncMock(return_value=SimpleNamespace(success=True,response=json.dumps({"intent":"search","groups":[["shoe","sneaker"]],"max_budget":"১৫০০","size_text":"৪২"})))
+    monkeypatch.setattr(ai_gateway,"execute_ai_gateway_prompt",gateway)
+    payload={"message":"১৫০০ টাকা বাজেটে ৪২ সাইজের জুতা", "allowed_product_ids":[str(s.product.id),str(hidden.id)]}
+    response=await market_api.post("/api/v1/marketplace/assistant",json=payload)
+    assert response.status_code==200,response.text
+    assert [(m["product_id"],m["variant_ids"]) for m in response.json()["matches"]]==[(str(s.product.id),[str(s.variant.id)])]
+    assert Decimal(response.json()["matches"][0]["product"]["variants"][0]["price"])==Decimal("1450.50")
+    sent=gateway.call_args.kwargs["prompt"]
+    assert "Secret shoe" not in sent and "1450.50" not in sent
+    assert await s.db.scalar(select(func.count(Order.id)))==0
+    unavailable=await market_api.post("/api/v1/marketplace/assistant",json={**payload,"selected_product_id":str(hidden.id)})
+    assert unavailable.status_code==404
+    assert (await market_api.post("/api/v1/marketplace/assistant",headers={"X-Marketplace-Key":"wrong"},json=payload)).status_code==401
+
+
+async def test_provider_failure_invented_budget_and_tracking_never_invent_replies(market_api, physical_shop, monkeypatch):
+    from app.services import ai_gateway
+    s=physical_shop
+    payload={"message":"shoe dekhao", "allowed_product_ids":[str(s.product.id)]}
+    gateway=AsyncMock(return_value=SimpleNamespace(success=False,response="Popular! Delivery tomorrow"))
+    monkeypatch.setattr(ai_gateway,"execute_ai_gateway_prompt",gateway)
+    result=(await market_api.post("/api/v1/marketplace/assistant",json=payload)).json()
+    assert result["state"]=="unavailable" and result["matches"]==[] and "tomorrow" not in str(result)
+    gateway.return_value=SimpleNamespace(success=True,response=json.dumps({"intent":"search","groups":[["shoe"]],"max_budget":"500"}))
+    assert (await market_api.post("/api/v1/marketplace/assistant",json=payload)).json()["state"]=="clarify"
+    gateway.return_value=SimpleNamespace(success=True,response=json.dumps({"intent":"tracking"}))
+    assert (await market_api.post("/api/v1/marketplace/assistant",json={**payload,"message":"ORD-8923 কোথায়"})).json()=={"state":"tracking","matches":[],"contract":"marketplace-finder-v1"}
+
+
+async def test_customer_hourly_limit_blocks_before_paid_gateway(market_api, physical_shop, monkeypatch):
+    from app.services import ai_gateway
+    from app.api.v1 import marketplace
+    redis=await marketplace.get_redis_client()
+    import hashlib
+    await redis.set("marketplace-shopping:"+hashlib.sha256(("a"*64).encode()).hexdigest(),30)
+    gateway=AsyncMock();monkeypatch.setattr(ai_gateway,"execute_ai_gateway_prompt",gateway)
+    response=await market_api.post("/api/v1/marketplace/assistant",json={"message":"shoe","allowed_product_ids":[str(physical_shop.product.id)]})
+    assert response.status_code==429
+    gateway.assert_not_called()
