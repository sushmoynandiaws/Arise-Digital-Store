@@ -0,0 +1,164 @@
+"""Structured marketplace selections reuse the source craft validator and merchant review."""
+import base64
+import copy
+import uuid
+from types import SimpleNamespace
+
+from fastapi import HTTPException
+from sqlalchemy import select
+from sqlalchemy.orm import selectinload
+
+from app.models.commerce import CheckoutDraft
+from app.models.product import Product
+from app.services import craft_checkout as craft
+from app.services.custom_orders import config_for, revision, validate_answer
+
+
+def public_config(product):
+    config = config_for(product)
+    if not config:
+        return None
+    from app.services.product_images import image_url
+    result = copy.deepcopy(config)
+    result.pop("knowledge_source", None)
+    if result.get("craft"):
+        for design in result["craft"]["designs"]:
+            design["image_url"] = image_url(design["asset_id"]) if design.get("asset_id") else design.get("image_url")
+            design.pop("asset_id", None)
+    return {**result, "revision": revision(config)}
+
+
+async def product_for(db, business, product_id):
+    from app.services.craft_knowledge import apply_knowledge
+    product = await db.scalar(select(Product).where(Product.id == product_id, Product.business_id == business.id,
+        Product.fulfilment_kind == "physical", Product.digital_archived.is_(False)).options(selectinload(Product.variants)))
+    if not product:
+        raise HTTPException(404, "Product not found")
+    await apply_knowledge(db, business.id, [product])
+    if product.__dict__.get("_craft_conflict") or not config_for(product):
+        raise HTTPException(409, "Custom product rules need seller review")
+    return product
+
+
+async def owned(db, draft_id, identity, user):
+    draft = await db.get(CheckoutDraft, draft_id)
+    data = draft.data if draft else {}
+    if (not draft or data.get("marketplace_buyer") != identity or not data.get("craft_lines")
+            or data.get("marketplace_user_id") and (not user or data["marketplace_user_id"] != str(user.id))):
+        raise HTTPException(404, "Custom selection not found")
+    from app.services.order_numbering import lock_numbering
+    await lock_numbering(db, draft.business_id)
+    draft = await db.scalar(select(CheckoutDraft).where(CheckoutDraft.id == draft_id).with_for_update().execution_options(populate_existing=True))
+    data = draft.data
+    if data.get("marketplace_buyer") != identity or data.get("marketplace_user_id") and (not user or data["marketplace_user_id"] != str(user.id)):
+        raise HTTPException(404, "Custom selection not found")
+    return draft
+
+
+async def image(db, business, conversation, identity, encoded):
+    from app.services.product_images import store_upload
+    from app.models.conversation import Message
+    if not isinstance(encoded, str) or len(encoded) > 1400000:
+        raise HTTPException(413, "Use an image smaller than 1 MB")
+    try:
+        raw = base64.b64decode(encoded, validate=True)
+    except ValueError:
+        raise HTTPException(422, "Choose a valid image") from None
+    asset = await store_upload(db, SimpleNamespace(business_id=business.id,
+        id=uuid.uuid5(business.id, identity)), raw, commit=False)
+    message = Message(conversation_id=conversation.id, from_type="customer", body="Custom order image",
+        attachment={"kind": "image", "asset_id": str(asset.id)})
+    db.add(message)
+    await db.flush()
+    return {"kind": "image", "message_id": str(message.id), "asset_id": str(asset.id)}
+
+
+async def save(db, business, channel, conversation, identity, user, req):
+    product = await product_for(db, business, req.product_id)
+    config = config_for(product)
+    if req.config_revision != revision(config):
+        raise HTTPException(409, "Product rules changed; reload before choosing")
+    variant = next((v for v in product.variants if v.id == req.variant_id), None)
+    if not variant or variant.stock < req.quantity:
+        raise HTTPException(409, "Selected package is unavailable")
+    rules = config.get("craft") or {}
+    image_values = [req.answers.get(f["id"]) for f in config["fields"] if f["type"] == "image"] + [req.artwork]
+    if any(v and not isinstance(v, str) for v in image_values) or sum(len(v or "") for v in image_values) > 1400000:
+        raise HTTPException(413, "Keep all uploaded images together under 1 MB")
+    codes = {d["code"] for d in rules.get("designs", [])}
+    if (any(s.code not in codes for s in req.selection) or len({s.code for s in req.selection}) != len(req.selection)
+            or len(req.selection) > 1 and not rules.get("allow_mixing")):
+        raise HTTPException(422, "Choose the seller's available designs")
+    fields = {f["id"]: f for f in config["fields"]}
+    if set(req.answers) - set(fields):
+        raise HTTPException(422, "Custom questions changed; reload this product")
+    answers = {}
+    # Validate ordinary fields before storing any customer images.
+    for key, field in fields.items():
+        value = req.answers.get(key)
+        if value is None or value == "":
+            if field["required"]:
+                raise HTTPException(422, f"Provide {field['label']}")
+            continue
+        if field["type"] != "image":
+            try:
+                answers[key] = validate_answer(field, value)
+            except ValueError as exc:
+                raise HTTPException(422, f"{field['label']}: {exc}") from exc
+    if req.artwork and not rules.get("allow_artwork"):
+        raise HTTPException(422, "The seller has not enabled customer artwork")
+    for key, field in fields.items():
+        if field["type"] == "image" and req.answers.get(key):
+            answers[key] = await image(db, business, conversation, identity, req.answers[key])
+    artwork = await image(db, business, conversation, identity, req.artwork) if req.artwork else None
+    line = {"line_key": str(uuid.uuid4()), "product_id": str(product.id), "variant_id": str(variant.id),
+        "qty": req.quantity, "selection": [s.model_dump() for s in req.selection], "answers": answers,
+        "answer_labels": {f["id"]: f["label"] for f in config["fields"]},
+        "config_revision": revision(config), "design_labels": {d["code"]: d["label"] for d in rules.get("designs", [])},
+        "design_assets": {d["code"]: d["asset_id"] for d in rules.get("designs", []) if d.get("asset_id")},
+        **craft.package_fields(product, variant)}
+    if artwork:
+        line["artwork"] = {**artwork, "role": "print_artwork"}
+    if rules.get("designs") and not line["selection"] and not artwork:
+        raise HTTPException(422, "Choose a design or provide artwork")
+    line["selection_revision"] = craft.spec_revision(line)
+    draft = await db.scalar(select(CheckoutDraft).where(CheckoutDraft.business_id == business.id,
+        CheckoutDraft.channel_id == channel.id, CheckoutDraft.conversation_id == conversation.id,
+        CheckoutDraft.order_id.is_(None), CheckoutDraft.data["marketplace_buyer"].as_string() == identity)
+        .order_by(CheckoutDraft.updated_at.desc()).limit(1).with_for_update())
+    if not draft:
+        # Keep the saved order's draft available for merchant changes and audit.
+        draft = CheckoutDraft(business_id=business.id, channel_id=channel.id, conversation_id=conversation.id,
+            recipient=identity + ":" + uuid.uuid4().hex)
+        db.add(draft)
+    draft.data = {"craft_lines": [line], "stage": "craft_review", "marketplace_buyer": identity,
+        "marketplace_user_id": str(user.id) if user else None, "marketplace_craft": True}
+    draft.confirmation_token, draft.order_id = None, None
+    await db.flush()
+    return draft
+
+
+def view(draft, product):
+    line = draft.data["craft_lines"][0]
+    try:
+        craft.quote_lines([product], [line])
+        reason = ""
+    except ValueError as exc:
+        reason = str(exc)
+    proof = line.get("proof") or {}
+    from app.services.product_images import image_url
+    return {"id": str(draft.id), "ready": not reason, "reason": reason,
+        "product_id": line["product_id"], "variant_id": line["variant_id"], "quantity": line["qty"],
+        "summary": summary(line),
+        "proof": {"id": proof["id"], "url": image_url(proof["asset_id"]),
+            "revision": proof["revision"], "approved": line.get("proof_approved") == proof["id"]} if proof else None}
+
+
+def summary(line):
+    result = [f"{line.get('design_labels', {}).get(s['code'], s['code'])} × {s['qty']}" for s in line.get("selection", [])]
+    for key, value in line.get("answers", {}).items():
+        label = line.get("answer_labels", {}).get(key, key)
+        result.append(f"{label}: " + ("Image received" if isinstance(value, dict) else str(value)))
+    if line.get("artwork"):
+        result.append("Customer artwork received")
+    return result
