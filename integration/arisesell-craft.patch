+    except Exception as exc:
+        raise HTTPException(503, "Shopping search is temporarily unavailable") from exc
+    if count > 30:
+        raise HTTPException(429, "Shopping search limit reached. Please use product search and try again later.")
+    business = await db.get(Business, req.shop_id)
+    if not business or not active_store(business) or not shop_json(business)["published"]:
+        raise HTTPException(404, "Shop is unavailable")
+    from app.services.ai_engine import customer_ai_paused
+    if customer_ai_paused(business.settings_data, business.timezone):
+        return {"state":"unavailable", "matches":[]}
+    from app.services.ai_quota_service import resolve_store_owner, check_ai_quota_available, consume_merchant_ai_quota
+    if not await resolve_store_owner(business, db) or not await check_ai_quota_available(business_id=business.id, db=db):
+        return {"state":"quota_exhausted", "matches":[]}
+    from app.services.marketplace_assistant import knowledge
+    evidence = await knowledge(db, business, req.shop_information, req.selected_product_id)
+    catalog = {"products": await products_json(db, business, published=True)}
+    allowed = {str(value) for value in req.allowed_product_ids}
+    products = [p for p in catalog["products"] if p["id"] in allowed and (not req.shop_id or p["shop_id"] == str(req.shop_id))]
+    if req.selected_product_id and not any(p["id"] == str(req.selected_product_id) for p in products):
+        raise HTTPException(404, "Selected product is unavailable")
+    # Hold the existing owner/credit locks until inference succeeds or rolls back.
+    usage = await consume_merchant_ai_quota(business_id=business.id, db=db, count=1, commit=False)
+    if not usage.get("success"):
+        return {"state":"quota_exhausted", "matches":[]}
+    try:
