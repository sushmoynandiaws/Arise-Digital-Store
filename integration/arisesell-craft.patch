+"""Unsupported recovery cannot disclose proof or change any order binding."""
+import copy
+import uuid
+from unittest.mock import AsyncMock
+
+import pytest
+
+from app.api.v1 import marketplace as market
+from app.models.order import Order
+from tests.test_marketplace import digital_engine, market_api, sales, sign_in, stock  # noqa: F401
+
+PHONE = "01799998888"
+PREFIX = "/api/v1/marketplace"
+NEW_BROWSER = "b" * 64
+
+
+async def place(client, sales, browser, token=None):
+    headers = {"X-Marketplace-Buyer": browser}
+    if token:
+        headers["Authorization"] = "Bearer " + token
+    quoted = await client.post(PREFIX + "/checkout/quote", headers=headers, json={
+        "shop_id": str(sales.business.id), "product_id": str(sales.product.id),
+        "variant_id": str(sales.variant.id), "quantity": 1, "provider": "bkash",
+        "buyer": {"name": "Recovery fixture", "phone": PHONE}})
+    assert quoted.status_code == 200, quoted.text
+    quote = quoted.json()
+    accepted = await client.post(PREFIX + "/checkout/accept", headers=headers, json={
+        "shop_id": str(sales.business.id), "product_id": str(sales.product.id),
+        "draft_id": quote["draft_id"], "quote_hash": quote["quote_hash"],
+        "idempotency_key": "recovery-fixture-" + browser[:8], "provider": "bkash", "accepted": True})
+    assert accepted.status_code == 200, accepted.text
+    return uuid.UUID(accepted.json()["id"])
+
+
+@pytest.fixture
+async def recovery_orders(market_api, sales):
+    await stock(sales, 3)
+    auth = await market_api.post(PREFIX + "/token", json=await sign_in(market_api))
+    assert auth.status_code == 200
+    token = auth.json()["access_token"]
+    ids = [await place(market_api, sales, "a" * 64),
+           await place(market_api, sales, "c" * 64, token),
+           await place(market_api, sales, "d" * 64)]
+    async with sales.factory() as db:
+        guest, account, offline = [await db.get(Order, id) for id in ids]
+        # Exercise checkout buyer_fields fallback, without changing account/provenance rules.
+        guest.phone = None
+        offline.checkout_data = {key: value for key, value in offline.checkout_data.items()
+                                 if key != "marketplace_buyer"}
+        offline.checkout_data = {**offline.checkout_data, "marketplace_user_id": str(sales.market_user.id)}
+        await db.commit()
+        before = [copy.deepcopy(order.checkout_data) for order in (guest, account, offline)]
+    return ids, before, token
+
+
+@pytest.mark.parametrize("phone", [PHONE, "01700000000"])
+async def test_phone_recovery_request_is_unavailable_without_enumerating_orders(market_api, sales, recovery_orders, monkeypatch, phone):
+    ids, before, _ = recovery_orders
+    monkeypatch.setattr(market, "get_redis_client", AsyncMock(side_effect=AssertionError("No recovery storage or delivery")))
+    response = await market_api.post(PREFIX + "/orders/track/request-otp", json={"phone": phone})
+    assert response.status_code == 503
+    assert response.headers["cache-control"] == "no-store"
+    assert set(response.json()) == {"detail"}
+    assert "unavailable" in response.json()["detail"]
+    market.get_redis_client.assert_not_awaited()
+    async with sales.factory() as db:
+        assert [(await db.get(Order, id)).checkout_data for id in ids] == before
+
+
+@pytest.mark.parametrize("otp", ["8369", "1234"])
+@pytest.mark.parametrize("signed_in", [False, True])
+async def test_legacy_proof_and_fixed_code_cannot_rebind_or_replay(market_api, sales, recovery_orders, monkeypatch, otp, signed_in):
+    ids, before, token = recovery_orders
+    redis = await market.get_redis_client()
+    for phone in (PHONE, "8801799998888", "+8801799998888"):
+        await redis.set("marketplace:otp:" + phone, "8369", ex=300)
+    monkeypatch.setattr(market, "get_redis_client", AsyncMock(side_effect=AssertionError("Do not accept legacy proofs")))
+    for browser in (NEW_BROWSER, "e" * 64):
+        headers = {"X-Marketplace-Buyer": browser}
+        if signed_in:
+            headers["Authorization"] = "Bearer " + token
+        response = await market_api.post(PREFIX + "/orders/track/verify-otp", headers=headers,
+                                         json={"phone": PHONE, "otp": otp})
+        assert response.status_code == 503
+        assert response.headers["cache-control"] == "no-store"
+        assert set(response.json()) == {"detail"}
+        assert (await market_api.get(PREFIX + f"/orders/{ids[0]}", headers=headers)).status_code == 404
+    market.get_redis_client.assert_not_awaited()
+    async with sales.factory() as db:
+        assert [(await db.get(Order, id)).checkout_data for id in ids] == before
+    assert (await market_api.get(PREFIX + f"/orders/{ids[0]}")).status_code == 200
+    assert (await market_api.get(PREFIX + f"/orders/{ids[1]}")).status_code == 404
+    assert (await market_api.get(PREFIX + f"/orders/{ids[1]}", headers={"Authorization": "Bearer " + token})).status_code == 200
+
+
+@pytest.mark.parametrize("path", ["request-otp", "verify-otp"])
+@pytest.mark.parametrize("key", ["", "wrong-service-key"])
+async def test_recovery_still_requires_bridge_authentication(market_api, path, key):
+    body = {"phone": PHONE, **({"otp": "8369"} if path == "verify-otp" else {})}
+    response = await market_api.post(PREFIX + "/orders/track/" + path,
+                                     headers={"X-Marketplace-Key": key}, json=body)
+    assert response.status_code == 401
+
+
+@pytest.mark.parametrize("path", ["request-otp", "verify-otp"])
+async def test_email_only_recovery_is_not_a_supported_phone_proof(market_api, path):
+    body = {"email": "fixture@example.test", **({"otp": "8369"} if path == "verify-otp" else {})}
+    response = await market_api.post(PREFIX + "/orders/track/" + path, json=body)
+    assert response.status_code == 422
