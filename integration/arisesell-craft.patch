@@ -0,0 +1,129 @@
+"""Custom Store checkout uses source rules, current proof and customer ownership."""
+import uuid
+from decimal import Decimal
+from types import SimpleNamespace
+
+import pytest
+from sqlalchemy import select
+from app.models.commerce import CheckoutDraft
+from app.models.order import Order
+from app.models.product_image import ImageAsset, OutboundPart
+from app.services.custom_orders import revision
+from tests.test_marketplace import market_api, physical_shop, digital_engine, sales, BUYER
+
+
+def request(s, revision_value):
+    return {"shop_id": str(s.business.id), "product_id": str(s.product.id), "variant_id": str(s.variant.id),
+        "quantity": 1, "config_revision": revision_value, "answers": {"printed": "Exact spelling"}}
+
+
+async def setup(s, *, proof=False):
+    s.business.kind = "Art & Crafts"
+    s.product.custom_order = {"enabled": True, "fields": [{"id": "printed", "label": "Printed name", "question": "What name?", "type": "text"}],
+        "advance_mode": "percent", "advance_value": "30", "craft": {"enabled": True, "proof_required": proof}}
+    s.variant.price = Decimal("600")
+    await s.db.commit()
+
+
+@pytest.mark.parametrize("craft_enabled", [True, False])
+async def test_custom_selection_quote_advance_order_and_isolation(market_api, physical_shop, craft_enabled):
+    s = physical_shop
+    await setup(s)
+    if not craft_enabled:
+        s.product.custom_order = {**s.product.custom_order, "craft": None}
+        await s.db.commit()
+    feed = (await market_api.get("/api/v1/marketplace/feed")).json()
+    assert feed["shops"][0]["kind"] == "Art & Crafts"
+    cfg = feed["products"][0]["custom_order"]
+    req = request(s, cfg["revision"])
+    bad = await market_api.post("/api/v1/marketplace/craft", json={**req, "answers": {}})
+    assert bad.status_code == 422
+    selection = await market_api.post("/api/v1/marketplace/craft", json=req)
+    assert selection.status_code == 200, selection.text
+    saved = selection.json()
+    assert saved["ready"]
+    path = f"/api/v1/marketplace/craft/{saved['id']}"
+    assert (await market_api.get(path, headers={"X-Marketplace-Buyer": "b" * 64})).status_code == 404
+    assert (await market_api.get(f"/api/v1/marketplace/checkout/{saved['id']}/scope")).status_code == 409
+    quote_req = {"shop_id": req["shop_id"], "product_id": req["product_id"], "variant_id": req["variant_id"],
+        "quantity": 1, "provider": "cod", "custom_draft_id": saved["id"],
+        "buyer": {"name": "Craft Buyer", "phone": "01712345678", "address": "House 12 Road 4 Mirpur", "district": "Dhaka"}}
+    assert (await market_api.post("/api/v1/marketplace/checkout/quote", json={**quote_req, "quantity": 2})).status_code == 409
+    quote = await market_api.post("/api/v1/marketplace/checkout/quote", json=quote_req)
+    assert quote.status_code == 200, quote.text
+    q = quote.json()
+    assert Decimal(q["snapshot"]["advance_amount"]) == 180
+    payload = {"shop_id": req["shop_id"], "product_id": req["product_id"], "draft_id": q["draft_id"], "quote_hash": q["quote_hash"],
+        "idempotency_key": "craft-checkout-test", "provider": "cod", "accepted": True}
+    order = await market_api.post("/api/v1/marketplace/checkout/accept", json=payload)
+    assert order.status_code == 200, order.text
+    assert order.json()["delivery_status"] == "awaiting_advance"
+    stored = await s.db.scalar(select(Order).where(Order.id == uuid.UUID(order.json()["id"])))
+    assert stored.checkout_data["production_required"]
+    assert stored.checkout_data["custom_details"][0]["answers"][0]["value"] == "Exact spelling"
+    again = await market_api.post("/api/v1/marketplace/checkout/accept", json=payload)
+    assert again.status_code == 200 and again.json()["id"] == order.json()["id"]
+    new = await market_api.post("/api/v1/marketplace/craft", json=req)
+    assert new.status_code == 200 and new.json()["id"] != saved["id"]
+    edited = await market_api.post("/api/v1/marketplace/craft", json={**req, "answers": {"printed": "New spelling"}})
+    assert edited.status_code == 200 and edited.json()["id"] == new.json()["id"]
+    original = await s.db.get(CheckoutDraft, uuid.UUID(saved["id"]))
+    await s.db.refresh(original)
+    assert str(original.order_id) == order.json()["id"]
+
+
+async def test_merchant_preview_in_store_cannot_send_or_accept_stale_proof(market_api, physical_shop):
+    from app.api.v1 import craft
+    from tests.store_principals import owner_for
+    s = physical_shop
+    await setup(s, proof=True)
+    cfg = (await market_api.get("/api/v1/marketplace/feed")).json()["products"][0]["custom_order"]
+    saved = (await market_api.post("/api/v1/marketplace/craft", json=request(s, cfg["revision"]))).json()
+    assert not saved["ready"]
+    draft = await s.db.get(CheckoutDraft, uuid.UUID(saved["id"]))
+    line = draft.data["craft_lines"][0]
+    from app.services.craft_checkout import review_revision
+    asset = ImageAsset(id=uuid.uuid4(), business_id=s.business.id, storage="local", storage_key="test/proof",
+        content_hash="test", mime_type="image/png", byte_size=10, width=10, height=10, created_by=s.owner.id)
+    s.db.add(asset); await s.db.commit()
+    await craft.review(draft.id, craft.Review(line_key=line["line_key"], revision=review_revision(line),
+        proof_asset_id=asset.id, send_to_customer=True), s.business.slug, owner_for(s.business), s.db)
+    assert not list(await s.db.scalars(select(OutboundPart)))
+    path = f"/api/v1/marketplace/craft/{draft.id}"
+    proof = (await market_api.get(path)).json()["proof"]
+    bad = await market_api.post(path + "/approve", json={"proof_id": "old-proof", "revision": proof["revision"]})
+    assert bad.status_code == 409
+    approved = await market_api.post(path + "/approve", json={"proof_id": proof["id"], "revision": proof["revision"]})
+    assert approved.status_code == 200 and approved.json()["ready"], approved.text
+    assert (await market_api.post(path + "/approve", headers={"X-Marketplace-Buyer": "b" * 64},
+        json={"proof_id": proof["id"], "revision": proof["revision"]})).status_code == 404
+    changed = await market_api.post("/api/v1/marketplace/craft", json={**request(s, cfg["revision"]), "quantity": 2})
+    assert changed.status_code == 200 and not changed.json()["ready"] and changed.json()["proof"] is None
+
+
+async def test_custom_images_rules_and_designs_cannot_be_forged(market_api, physical_shop, monkeypatch):
+    import copy
+    import base64
+    import io
+    from PIL import Image
+    from app.services import product_images
+    s = physical_shop
+    await setup(s)
+    cfg = copy.deepcopy(s.product.custom_order)
+    cfg["craft"]["allow_artwork"] = True
+    s.product.custom_order = cfg
+    await s.db.commit()
+    public = (await market_api.get("/api/v1/marketplace/feed")).json()["products"][0]["custom_order"]
+    req = request(s, public["revision"])
+    assert (await market_api.post("/api/v1/marketplace/craft", json={**req, "config_revision": "0"*64})).status_code == 409
+    assert (await market_api.post("/api/v1/marketplace/craft", json={**req, "selection": [{"code":"OTHER", "qty":1}]})).status_code == 422
+    assert (await market_api.post("/api/v1/marketplace/craft", json={**req, "artwork":"not-base64"})).status_code == 422
+    assert (await market_api.post("/api/v1/marketplace/craft", json={**req, "artwork":base64.b64encode(b"not an image").decode()})).status_code == 422
+    monkeypatch.setattr(product_images, "_store", lambda *args: None)
+    output = io.BytesIO(); Image.new("RGB", (10,10), "white").save(output, format="PNG")
+    result = await market_api.post("/api/v1/marketplace/craft", json={**req, "artwork":base64.b64encode(output.getvalue()).decode()})
+    assert result.status_code == 200 and not result.json()["ready"], result.text
+    assert "Merchant" in result.json()["reason"]
+    draft = await s.db.get(CheckoutDraft, uuid.UUID(result.json()["id"]))
+    artwork = draft.data["craft_lines"][0]["artwork"]
+    assert artwork["role"] == "print_artwork" and artwork.get("asset_id")
