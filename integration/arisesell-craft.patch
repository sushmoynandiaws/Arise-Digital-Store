+@router.post("/assistant", dependencies=[Depends(bridge)])
+async def shopping_search(req: ShoppingSearch, request: Request, db=Depends(get_db)):
+    from app.services.marketplace_assistant import find
+    identity = buyer_id(request)
+    try:
+        redis = await get_redis_client()
+        if not redis:
+            raise HTTPException(503, "Shopping search is temporarily unavailable")
+        key = "marketplace-shopping:" + identity
+        count = await redis.incr(key)
+        await redis.expire(key, 3600, nx=True)
+    except Exception as exc:
+        raise HTTPException(503, "Shopping search is temporarily unavailable") from exc
+    if count > 30:
+        raise HTTPException(429, "Shopping search limit reached. Please use product search and try again later.")
+    catalog = await feed(db)
+    allowed = {str(value) for value in req.allowed_product_ids}
+    products = [p for p in catalog["products"] if p["id"] in allowed and (not req.shop_id or p["shop_id"] == str(req.shop_id))]
+    if req.selected_product_id and not any(p["id"] == str(req.selected_product_id) for p in products):
+        raise HTTPException(404, "Selected product is unavailable")
+    if not products:
+        return {"state":"no_matches", "matches":[], "contract":"marketplace-finder-v1"}
+    return await find(db, req, products)
+
