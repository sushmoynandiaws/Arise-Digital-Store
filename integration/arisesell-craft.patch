+@router.post("/craft/{draft_id}/approve", dependencies=[Depends(bridge)])
+async def approve_craft(draft_id: uuid.UUID, req: CraftApproval, request: Request, user=Depends(optional_user), db=Depends(get_db)):
+    import copy
+    from app.services import marketplace_craft, craft_checkout
+    draft = await marketplace_craft.owned(db, draft_id, buyer_id(request), user)
+    if draft.order_id:
+        raise HTTPException(409, "Order is already saved")
+    data = copy.deepcopy(draft.data)
+    line = data["craft_lines"][0]
+    business = await public_product(db, draft.business_id, uuid.UUID(line["product_id"]))
+    product = await marketplace_craft.product_for(db, business, uuid.UUID(line["product_id"]))
+    proof = line.get("proof") or {}
+    if (proof.get("id") != req.proof_id or proof.get("revision") != req.revision
+            or req.revision != craft_checkout.spec_revision(line)):
+        raise HTTPException(409, "Preview changed; review the current preview")
+    line["proof_approved"] = req.proof_id
+    data.pop("snapshot", None)
+    data.pop("quote_hash", None)
+    draft.data, draft.confirmation_token = data, None
+    result = marketplace_craft.view(draft, product)
+    await db.commit()
+    return result
 
 
