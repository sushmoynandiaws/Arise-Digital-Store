+@pytest.mark.parametrize("digital_engine", ["postgres"], indirect=True)
+@pytest.mark.parametrize("first_fails", [False, True])
+async def test_last_unit_is_reserved_before_concurrent_provider_work(market_api, physical_shop, monkeypatch, first_fails):
+    from app.services import ai_gateway, ai_quota_service
+    from app.models.user import User
+    s = physical_shop
+    owner = await s.db.get(User, s.owner.id)
+    owner.ai_quota = s.business.orders_quota = 100
+    owner.ai_used = s.business.orders_used = 99
+    s.business.settings_data = {**s.business.settings_data, "subscribed_quota": 100, "messages_used": 99}
+    await s.db.commit()
+    # Both preflights pass; only the real owner/credit transaction can admit work.
+    monkeypatch.setattr(ai_quota_service, "check_ai_quota_available", AsyncMock(return_value=True))
+    entered, release, second_reserving = asyncio.Event(), asyncio.Event(), asyncio.Event()
+    consume = ai_quota_service.consume_merchant_ai_quota
+    sessions = []
+    async def reserve(*args, **kwargs):
+        assert kwargs["commit"] is False
+        sessions.append(kwargs["db"])
+        if len(sessions) == 2:
+            second_reserving.set()
+        return await consume(*args, **kwargs)
+    monkeypatch.setattr(ai_quota_service, "consume_merchant_ai_quota", reserve)
+    calls = 0
+    async def provider(**kwargs):
+        nonlocal calls
+        calls += 1
+        reserved = await kwargs["db"].get(User, owner.id)
+        assert reserved.ai_used == 100
+        if calls == 1:
+            entered.set()
+            await asyncio.wait_for(release.wait(), 5)
+            if first_fails:
+                return SimpleNamespace(success=False, response="")
+        return SimpleNamespace(success=True, response=json.dumps({"intent": "clarify"}))
+    monkeypatch.setattr(ai_gateway, "execute_ai_gateway_prompt", provider)
+    payload = {"shop_id": str(s.business.id), "message": "Clothing", "allowed_product_ids": [str(s.product.id)]}
+    tasks = []
+    try:
+        tasks.append(asyncio.create_task(market_api.post("/api/v1/marketplace/assistant", json=payload)))
+        await asyncio.wait_for(entered.wait(), 5)
+        tasks.append(asyncio.create_task(market_api.post("/api/v1/marketplace/assistant", json=payload)))
+        await asyncio.wait_for(second_reserving.wait(), 5)
+        assert sessions[0] is not sessions[1]
+        assert calls == 1
+        release.set()
+        first, second = await asyncio.wait_for(asyncio.gather(*tasks), 5)
+        assert first.status_code == second.status_code == 200
+        assert first.json()["state"] == ("unavailable" if first_fails else "clarify")
+        assert second.json()["state"] == ("clarify" if first_fails else "quota_exhausted")
+        assert calls == (2 if first_fails else 1)
+    finally:
+        release.set()
+        for task in tasks:
+            if not task.done():
+                task.cancel()
+        await asyncio.gather(*tasks, return_exceptions=True)
+    await s.db.refresh(s.business)
+    await s.db.refresh(owner)
+    assert owner.ai_used == s.business.orders_used == 100
+
