+async def context(db, business, identity, fields=None):
+    await lock_business(db, business.id)
+    channel = await db.scalar(select(ConnectedChannel).where(ConnectedChannel.business_id == business.id,
+        ConnectedChannel.channel_type == "marketplace", ConnectedChannel.external_id == "arise-digital-store"))
+    if not channel:
+        channel = ConnectedChannel(business_id=business.id, channel_type="marketplace", external_id="arise-digital-store", label="Arise Digital Store", is_live=True)
+        db.add(channel)
+        await db.flush()
+    if not channel.is_live:
+        raise HTTPException(409, "This shop's marketplace connection is paused")
+    conversation = await db.scalar(select(Conversation).where(Conversation.business_id == business.id,
+        Conversation.channel_id == channel.id, Conversation.handle == identity))
+    if not conversation:
+        conversation = Conversation(business_id=business.id, channel_id=channel.id, channel_type="marketplace", handle=identity,
+            customer_name=(fields or {}).get("name") or "Marketplace customer")
+        db.add(conversation)
+        await db.flush()
+    return channel, conversation
