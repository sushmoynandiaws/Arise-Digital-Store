+++ b/frontend/app/marketplace/connect/page.tsx
@@ -0,0 +1,31 @@
+"use client";
+import {Suspense,useState} from "react";
+import {useSearchParams} from "next/navigation";
+import Link from "next/link";
+import {useAuth} from "@/lib/auth-context";
+import {api} from "@/lib/api-client";
+import {Button,Wordmark} from "@/components/ui/primitives";
+import {UiText,useUiCopy} from "@/lib/i18n";
+
+function ConnectForm() {
+  const copy=useUiCopy();
+  const params=useSearchParams();const {user,loading}=useAuth();
+  const [busy,setBusy]=useState(false);const [error,setError]=useState("");
+  const payload={state:params.get("state")||"",code_challenge:params.get("code_challenge")||"",redirect_uri:params.get("redirect_uri")||""};
+  const returnTo=`/marketplace/connect?${params.toString()}`;
+  const valid=/^[A-Za-z0-9_-]{32,128}$/.test(payload.state)&&/^[A-Za-z0-9_-]{43}$/.test(payload.code_challenge)&&!!payload.redirect_uri;
+  async function connect() {
+    if(busy)return;setBusy(true);setError("");
+    try {const result=await api.request<{redirect:string}>("/marketplace/authorize",{method:"POST",body:JSON.stringify(payload)});window.location.assign(result.redirect);}
+    catch(error){setError(error instanceof Error?error.message:copy.text("Unable to connect. Please retry."));setBusy(false);}
+  }
+  return <main className="min-h-screen bg-canvas px-4 py-16 text-text"><section className="mx-auto max-w-lg space-y-6 rounded-2xl border border-line bg-surface p-7 shadow-sm">
+    <Wordmark/><div><p className="mb-2 text-sm font-semibold text-signal"><UiText>Arise Digital Store</UiText></p><h1 className="text-2xl font-semibold"><UiText>Your shop. A bigger audience.</UiText></h1><p className="mt-3 text-text-2"><UiText>Use your AriseSell account to open your digital storefront. Choose what to publish after connecting.</UiText></p></div>
+    {!valid?<p role="alert" className="text-coral"><UiText>This connection link is incomplete. Return to Arise Digital Store and choose Continue with AriseSell again.</UiText></p>:loading?<p role="status"><UiText>Checking your account…</UiText></p>:!user?<div className="flex flex-wrap gap-3"><Button href={`/login?from=${encodeURIComponent(returnTo)}`}><UiText>Sign in to AriseSell</UiText></Button><Button variant="outline" href={`/signup?from=${encodeURIComponent(returnTo)}`}><UiText>Create an account</UiText></Button></div>:<>
+      <p><UiText>Continue as</UiText> <strong>{user.email}</strong></p><ul className="list-disc space-y-2 pl-5 text-sm text-text-2"><li><UiText>Connect your account and digital stores.</UiText></li><li><UiText>Choose your public shop profile and products.</UiText></li><li><UiText>Keep payments, stock and delivery managed in AriseSell.</UiText></li></ul><p className="text-xs text-text-3"><UiText>Your password and private stock are never shared with the marketplace browser.</UiText></p>
+      {error&&<p role="alert" className="text-sm text-coral">{error}</p>}<Button disabled={busy} onClick={connect}>{copy.text(busy?"Connecting…":"Continue to Arise Digital Store")}</Button>
+    </>}
+    <Link href="/console" className="block text-sm text-text-3 underline"><UiText>Return to AriseSell</UiText></Link>
+  </section></main>;
+}
+export default function MarketplaceConnectPage(){return <Suspense fallback={<p role="status"><UiText>Loading secure connection…</UiText></p>}><ConnectForm/></Suspense>;}
