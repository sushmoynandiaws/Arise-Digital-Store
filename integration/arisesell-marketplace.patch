+    assert (await market_api.post(f"/api/v1/marketplace/orders/{order_id}/reveal", headers=other)).status_code == 404
+    assert (await market_api.post(f"/api/v1/marketplace/orders/{order_id}/proof", headers=other, json={"trx_id": "GUESS123"})).status_code == 404
+    assert not (await market_api.get("/api/v1/marketplace/orders", headers=other)).json()["orders"]
+
+
+async def test_marketplace_signed_in_buyer_can_retrieve_their_order_on_another_browser(market_api, sales):
+    await stock(sales)
+    token = (await market_api.post("/api/v1/marketplace/token", json=await sign_in(market_api))).json()["access_token"]
+    market_api.headers["Authorization"] = "Bearer " + token
+    accepted, _ = await quote_and_accept(market_api, sales)
+    order_id = accepted.json()["id"]
+    another_browser = {"X-Marketplace-Buyer": "b" * 64}
+    assert (await market_api.get(f"/api/v1/marketplace/orders/{order_id}", headers=another_browser)).status_code == 200
+    assert len((await market_api.get("/api/v1/marketplace/orders", headers=another_browser)).json()["orders"]) == 1
+    market_api.headers.pop("Authorization")
+    assert (await market_api.get(f"/api/v1/marketplace/orders/{order_id}", headers=another_browser)).status_code == 404
+    assert (await market_api.get(f"/api/v1/marketplace/orders/{order_id}")).status_code == 404
+    assert not (await market_api.get("/api/v1/marketplace/orders")).json()["orders"]
+
+
+async def test_marketplace_account_checkout_cannot_be_accepted_after_sign_out(market_api, sales):
+    await stock(sales)
+    token = (await market_api.post("/api/v1/marketplace/token", json=await sign_in(market_api))).json()["access_token"]
+    market_api.headers["Authorization"] = "Bearer " + token
+    response = await market_api.post("/api/v1/marketplace/checkout/quote", json={
+        "shop_id": str(sales.business.id), "product_id": str(sales.product.id), "variant_id": str(sales.variant.id),
+        "quantity": 1, "provider": "bkash", "buyer": {"name": "Signed in buyer"}})
+    assert response.status_code == 200, response.text
+    quoted = response.json()
+    market_api.headers.pop("Authorization")
+    response = await market_api.post("/api/v1/marketplace/checkout/accept", json={
+        "shop_id": str(sales.business.id), "product_id": str(sales.product.id), "draft_id": quoted["draft_id"],
+        "quote_hash": quoted["quote_hash"], "idempotency_key": "account-checkout-after-logout", "provider": "bkash", "accepted": True})
+    assert response.status_code == 409
+    assert await sales.db.scalar(select(func.count()).select_from(Order)) == 0
+
+
+async def test_marketplace_manual_delivery_needs_seller_prepare_and_send(market_api, sales):
+    sales.product.digital_config = {**sales.product.digital_config, "delivery_mode": "manual"}
+    sales.variant.stock = 2
+    await sales.db.commit()
+    response, _ = await quote_and_accept(market_api, sales)
+    assert response.status_code == 200, response.text
+    order = await sales.db.get(Order, uuid.UUID(response.json()["id"]))
+    await pay(sales, order)
+    unit = (await checkout.units_for(sales.db, order))[0]
+    assert unit.status == "awaiting_manual"
+    await delivery.prepare_delivery(sales.db, sales.business, order, PrepareRequest(idempotency_key="manual-marketplace",
+        units=[{"fulfilment_id": unit.id, "content": "PRIVATE-MANUAL-DELIVERY"}]), sales.owner.id)
+    await sales.db.commit()
+    assert (await market_api.post(f"/api/v1/marketplace/orders/{order.id}/reveal")).status_code == 409
+    await delivery.queue_delivery(sales.db, sales.business, order, actor=sales.owner.id, key="manual-market-send")
+    await sales.db.commit()
+    response = await market_api.post(f"/api/v1/marketplace/orders/{order.id}/reveal")
+    assert response.status_code == 200 and "PRIVATE-MANUAL-DELIVERY" in response.text
+
+
+async def test_marketplace_last_unit_cannot_be_sold_twice(market_api, sales):
+    await stock(sales, 1)
+    first, _ = await quote_and_accept(market_api, sales)
+    assert first.status_code == 200
+    second, _ = await quote_and_accept(market_api, sales, identity="b" * 64)
+    assert second.status_code == 409
+    assert await sales.db.scalar(select(func.count()).select_from(Order)) == 1
+    assert await sales.db.scalar(select(func.count()).select_from(DigitalPaymentRequest)) == 1
+
+
+async def test_marketplace_pkce_is_single_use_and_bound_to_live_arisesell_session(market_api, sales):
+    exchange = await sign_in(market_api)
+    response = await market_api.post("/api/v1/marketplace/token", json=exchange)
+    assert response.status_code == 200, response.text
+    token = response.json()["access_token"]
+    assert (await market_api.post("/api/v1/marketplace/token", json=exchange)).status_code == 400
+    headers = {"Authorization": "Bearer " + token}
+    assert (await market_api.get("/api/v1/marketplace/me", headers=headers)).status_code == 200
+    sales.market_session.is_active = False
+    await sales.db.commit()
+    assert (await market_api.get("/api/v1/marketplace/me", headers=headers)).status_code == 401
+
+
+async def test_marketplace_rejects_wrong_pkce_and_unregistered_redirect(market_api):
+    exchange = await sign_in(market_api)
+    exchange["code_verifier"] = "x" * 64
+    assert (await market_api.post("/api/v1/marketplace/token", json=exchange)).status_code == 400
+    assert (await market_api.post("/api/v1/marketplace/authorize", json={"state": "s" * 64,
+        "code_challenge": "x" * 43, "redirect_uri": "https://attacker.test/api/auth/callback"})).status_code == 400
+
+
+async def test_marketplace_listing_is_owned_and_selection_remains_in_arisesell(market_api, sales):
+    token = (await market_api.post("/api/v1/marketplace/token", json=await sign_in(market_api))).json()["access_token"]
+    headers = {"Authorization": "Bearer " + token}
+    body = {"published": True, "name": "Updated shop", "description": "Authorized product marketplace shop", "support": "help@example.test", "product_ids": [str(sales.product.id)]}
+    assert (await market_api.put(f"/api/v1/marketplace/stores/{uuid.uuid4()}/listing", headers=headers, json=body)).status_code == 404
+    bad = {**body, "product_ids": [str(uuid.uuid4())]}
+    assert (await market_api.put(f"/api/v1/marketplace/stores/{sales.business.id}/listing", headers=headers, json=bad)).status_code == 409
+    assert (await market_api.put(f"/api/v1/marketplace/stores/{sales.business.id}/listing", headers=headers, json=body)).status_code == 200
+    assert (await market_api.get("/api/v1/marketplace/feed")).json()["shops"][0]["name"] == "Updated shop"
+    body["published"] = False
+    assert (await market_api.put(f"/api/v1/marketplace/stores/{sales.business.id}/listing", headers=headers, json=body)).status_code == 200
+    assert not (await market_api.get("/api/v1/marketplace/feed")).json()["products"]
+
+
+async def test_marketplace_source_bridge_is_disabled_without_configuration(market_api, monkeypatch):
+    assert (await market_api.get("/api/v1/marketplace/feed", headers={"X-Marketplace-Key": "wrong"})).status_code == 401
+    monkeypatch.setattr(settings, "MARKETPLACE_BRIDGE_KEY", "")
+    assert (await market_api.get("/api/v1/marketplace/feed")).status_code == 503
diff --git a/frontend/app/marketplace/connect/page.tsx b/frontend/app/marketplace/connect/page.tsx
new file mode 100644
