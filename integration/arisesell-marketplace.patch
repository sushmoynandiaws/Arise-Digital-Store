diff --git a/frontend/lib/login-return-path.ts b/frontend/lib/login-return-path.ts
index 710fafc6..83d4ddd2 100644
--- a/frontend/lib/login-return-path.ts
+++ b/frontend/lib/login-return-path.ts
@@ -7,3 +7,26 @@ export function loginReturnPath(value: string | null, origin: string): string {
     return "/console";
   }
 }
+
+const MARKETPLACE_SIGNUP_RETURN = "arise_marketplace_signup_return";
+type ReturnStorage = Pick<Storage, "getItem" | "setItem" | "removeItem">;
+
+export function rememberMarketplaceSignupReturn(value: string | null, storage: ReturnStorage): void {
+  try {
+    if (value?.startsWith("/marketplace/connect?")) {
+      storage.setItem(MARKETPLACE_SIGNUP_RETURN, JSON.stringify({value, expires: Date.now() + 600_000}));
+    } else storage.removeItem(MARKETPLACE_SIGNUP_RETURN);
+  } catch { /* The explicit return query still supports verification when storage is unavailable. */ }
+}
+
+export function verificationLoginPath(explicit: string | null, storage: ReturnStorage): string {
+  let remembered: string | null = null;
+  try {
+    const raw = storage.getItem(MARKETPLACE_SIGNUP_RETURN);
+    storage.removeItem(MARKETPLACE_SIGNUP_RETURN);
+    const saved = raw ? JSON.parse(raw) : null;
+    if (typeof saved?.value === "string" && saved.value.startsWith("/marketplace/connect?") && saved.expires > Date.now()) remembered = saved.value;
+  } catch { /* Verification must remain usable without browser storage. */ }
+  const destination = explicit || remembered;
+  return destination ? `/login?from=${encodeURIComponent(destination)}` : "/login";
+}
