@@ -0,0 +1,22 @@
+import fs from "node:fs";
+import vm from "node:vm";
+import assert from "node:assert/strict";
+import ts from "typescript";
+const exports={};
+vm.runInNewContext(ts.transpileModule(fs.readFileSync("lib/login-return-path.ts","utf8"),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,URL,Date});
+const values=new Map();
+const storage={getItem:key=>values.get(key)??null,setItem:(key,value)=>values.set(key,value),removeItem:key=>values.delete(key)};
+const target="/marketplace/connect?state=browser-bound-state&code_challenge=public-challenge";
+exports.rememberMarketplaceSignupReturn(target,storage);
+assert.equal(exports.verificationLoginPath(null,storage),`/login?from=${encodeURIComponent(target)}`,"A verification link in a new tab returns to the original marketplace flow");
+assert.equal(values.size,0,"The one-time return is cleared after verification");
+assert.equal(exports.verificationLoginPath(null,storage),"/login");
+exports.rememberMarketplaceSignupReturn(target,storage);
+assert.equal(exports.verificationLoginPath("/console",storage),"/login?from=%2Fconsole");assert.equal(values.size,0);
+exports.rememberMarketplaceSignupReturn("https://attacker.test",storage);assert.equal(values.size,0);
+storage.setItem("arise_marketplace_signup_return",JSON.stringify({value:target,expires:Date.now()-1}));assert.equal(exports.verificationLoginPath(null,storage),"/login");
+storage.setItem("arise_marketplace_signup_return",JSON.stringify({value:"//attacker.test",expires:Date.now()+60000}));assert.equal(exports.verificationLoginPath(null,storage),"/login");
+assert.equal(exports.loginReturnPath("https://attacker.test", "https://arisesell.com"),"/console");
+const blocked={getItem(){throw new Error("storage blocked")},setItem(){throw new Error("storage blocked")},removeItem(){throw new Error("storage blocked")}};
+exports.rememberMarketplaceSignupReturn(target,blocked);assert.equal(exports.verificationLoginPath(target,blocked),`/login?from=${encodeURIComponent(target)}`);
+console.log("Marketplace signup/verification return paths preserve PKCE navigation, expire safely, and never allow external login redirects.");
