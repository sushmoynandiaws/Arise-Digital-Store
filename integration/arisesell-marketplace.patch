+def shop_json(business):
+    listing = (business.settings_data or {}).get("marketplace_listing") or {}
+    return {"id": str(business.id), "slug": business.slug, "name": listing.get("name") or business.name,
+        "description": listing.get("description") or "", "logo_url": listing.get("logo_url") or business.logo_url or "",
+        "cover_url": listing.get("cover_url") or "", "support": listing.get("support") or "",
+        "published": listing.get("published") is True}
