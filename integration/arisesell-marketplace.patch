+async def public_product(db, shop_id, product_id):
+    business = await lock_business(db, shop_id)
+    if not business or not active_store(business) or not shop_json(business)["published"]:
+        raise HTTPException(404, "Shop is unavailable")
+    listing = (business.settings_data or {}).get("marketplace_listing") or {}
+    if str(product_id) not in (listing.get("product_ids") or []):
+        raise HTTPException(404, "Product is not published on this shop")
+    return business
