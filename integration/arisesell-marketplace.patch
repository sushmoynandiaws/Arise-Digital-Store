+@router.post("/checkout/quote", dependencies=[Depends(bridge)])
+async def create_quote(req: MarketQuote, request: Request, user=Depends(optional_user), db=Depends(get_db)):
+    identity = buyer_id(request)
+    business = await public_product(db, req.shop_id, req.product_id)
+    channel, conversation = await context(db, business, identity, req.buyer.model_dump())
+    draft = await checkout.create_quote(db, business, channel, conversation, identity,
+        QuoteRequest(**req.model_dump(include={"product_id", "variant_id", "quantity", "provider"})))
+    draft.data = {**draft.data, "buyer_fields": req.buyer.model_dump(), "marketplace_buyer": identity,
+        "marketplace_user_id": str(user.id) if user else None}
+    await db.commit()
+    return {"draft_id": str(draft.id), "quote_hash": draft.data["quote_hash"], "snapshot": draft.data["snapshot"]}
+
+
+@router.post("/checkout/accept", dependencies=[Depends(bridge)])
+async def accept_quote(req: MarketAccept, request: Request, user=Depends(optional_user), db=Depends(get_db)):
+    identity = buyer_id(request)
+    business = await public_product(db, req.shop_id, req.product_id)
+    channel, conversation = await context(db, business, identity)
+    draft = await db.get(CheckoutDraft, req.draft_id)
+    if not draft or (draft.data or {}).get("snapshot", {}).get("product_id") != str(req.product_id):
+        raise HTTPException(404, "Checkout not found")
+    started_by = (draft.data or {}).get("marketplace_user_id")
+    if started_by and (not user or str(user.id) != started_by):
+        raise HTTPException(409, "Sign in with the account that started this checkout")
+    order = await checkout.accept_quote(db, business, channel, conversation, identity, req.draft_id,
+        AcceptRequest(**req.model_dump(include={"quote_hash", "idempotency_key", "provider", "accepted"})), "marketplace:" + req.idempotency_key)
+    order.checkout_data = {**order.checkout_data, "marketplace_buyer": identity,
+        "marketplace_user_id": (draft.data or {}).get("marketplace_user_id")}
+    await db.commit()
+    return await order_json(db, order)
+
+
+def order_owned(order, identity, user):
+    data = order.checkout_data or {}
+    if not data.get("marketplace_buyer"):
+        return False
+    if data.get("marketplace_user_id"):
+        return bool(user and data["marketplace_user_id"] == str(user.id))
+    return hmac.compare_digest(data["marketplace_buyer"], identity)
+
+
+async def bound_order(db, request, order_id, user):
+    identity = buyer_id(request)
+    order = await db.get(Order, order_id)
+    if not order or order.fulfilment_kind != "digital" or not order_owned(order, identity, user):
+        raise HTTPException(404, "Purchase not found")
+    return await checkout.lock_order(db, order.business_id, order.id)
+
+
+async def order_json(db, order):
+    payment = await checkout.payment_request_for(db, order)
+    business = await db.get(Business, order.business_id)
+    quote = (order.checkout_data or {}).get("digital_quote") or {}
+    units = await checkout.units_for(db, order)
+    return {"id": str(order.id), "ref": order.ref, "shop": shop_json(business), "name": quote.get("name"),
+        "quantity": quote.get("quantity"), "total": quote.get("total"), "currency": "BDT", "payment_status": order.payment_status,
+        "delivery_status": order.digital_status, "delivery_mode": (quote.get("digital_config") or {}).get("delivery_mode"),
+        "delivery_estimate": (quote.get("digital_config") or {}).get("delivery_estimate"),
+        "created_at": utc(order.placed_at).isoformat(),
+        "ready": order.payment_status == "paid" and bool(units) and all(u.stock_unit_id and u.status in {"queued", "accepted", "delivered"} for u in units),
+        "payment": {"provider": payment.provider, "account": payment.receiving_account, "amount": str(payment.amount),
+            "trx_id": payment.proof_trx_id, "expires_at": utc(payment.expires_at).isoformat()} if payment else None}
+
+
+@router.get("/orders", dependencies=[Depends(bridge)])
+async def orders(request: Request, user=Depends(optional_user), db=Depends(get_db)):
+    identity = buyer_id(request)
+    from sqlalchemy import and_, or_
+    where = [and_(Order.checkout_data["marketplace_buyer"].as_string() == identity,
+        Order.checkout_data["marketplace_user_id"].as_string().is_(None))]
+    if user:
+        where.append(Order.checkout_data["marketplace_user_id"].as_string() == str(user.id))
+    entries = list(await db.scalars(select(Order).where(Order.fulfilment_kind == "digital", or_(*where))
+        .order_by(Order.placed_at.desc()).limit(100)))
+    return {"orders": [await order_json(db, order) for order in entries]}
+
+
+@router.get("/orders/{order_id}", dependencies=[Depends(bridge)])
+async def order_status(order_id: uuid.UUID, request: Request, user=Depends(optional_user), db=Depends(get_db)):
+    order = await bound_order(db, request, order_id, user)
+    payment = await checkout.payment_request_for(db, order)
+    if payment:
+        await checkout.expire_request(db, payment)
+    await db.commit()
+    return await order_json(db, order)
+
+
+@router.post("/orders/{order_id}/proof", dependencies=[Depends(bridge)])
+async def proof(order_id: uuid.UUID, req: PaymentProofRequest, request: Request, user=Depends(optional_user), db=Depends(get_db)):
+    order = await bound_order(db, request, order_id, user)
+    business = await db.get(Business, order.business_id)
+    payment = await checkout.payment_request_for(db, order)
+    if not payment:
+        raise HTTPException(409, "Payment request not found")
+    await checkout.expire_request(db, payment)
+    if payment.status in {"expired", "cancelled"}:
+        raise HTTPException(409, "This payment request expired. Please start a new checkout.")
+    await checkout.submit_proof(db, business, payment, req.trx_id)
+    await db.commit()
+    return await order_json(db, order)
+
+
+@router.post("/orders/{order_id}/reveal", dependencies=[Depends(bridge)])
+async def reveal(order_id: uuid.UUID, request: Request, user=Depends(optional_user), db=Depends(get_db)):
+    order = await bound_order(db, request, order_id, user)
+    business = await db.get(Business, order.business_id)
+    if order.payment_status != "paid" or not active_store(business) or order.digital_status == "needs_attention":
+        raise HTTPException(409, "Your items will be available after verified payment and preparation")
+    result = []
+    for fulfilment in await checkout.units_for(db, order):
+        if not fulfilment.stock_unit_id or fulfilment.status not in {"queued", "accepted", "delivered"}:
+            raise HTTPException(409, "The seller is still preparing this order")
+        stock = await db.get(DigitalStockUnit, fulfilment.stock_unit_id)
+        if not stock or stock.business_id != business.id or stock.state != "allocated":
+            raise HTTPException(409, "Your delivery needs seller review")
+        result.append({"item": fulfilment.unit_index, "content": decrypt_stock(stock)})
+        stock.exposed_at = stock.exposed_at or utcnow()
+        if fulfilment.status != "delivered":
+            fulfilment.status, fulfilment.accepted_at, fulfilment.delivered_at = "delivered", utcnow(), utcnow()
+            await event(db, business.id, order.id, "marketplace_delivery_opened", "customer", reference=fulfilment.id)
+    if not result:
+        raise HTTPException(409, "No delivery items are available")
+    from app.services.digital_fulfilment import project_status
+    await db.flush()
+    await project_status(db, order)
+    await db.commit()
+    return {"items": result, "delivery_status": order.digital_status}
