+async def products_json(db, business, *, published=False):
+    listing = (business.settings_data or {}).get("marketplace_listing") or {}
+    selected = set(listing.get("product_ids") or [])
+    products = list(await db.scalars(select(Product).where(Product.business_id == business.id,
+        Product.fulfilment_kind == "digital", Product.digital_archived.is_(False)).options(selectinload(Product.variants))))
+    available = dict((await db.execute(select(DigitalStockUnit.variant_id, func.count()).where(
+        DigitalStockUnit.business_id == business.id, DigitalStockUnit.state == "available").group_by(DigitalStockUnit.variant_id))).all())
+    result = []
+    for product in products:
+        config = config_for(product)
+        if published and (str(product.id) not in selected or not config.sales_enabled):
+            continue
+        variants = [{"id": str(v.id), "name": v.label, "price": str(v.price),
+            "stock": available.get(v.id, 0) if config.delivery_mode == "automatic" else v.stock} for v in product.variants]
+        result.append({"id": str(product.id), "shop_id": str(business.id), "name": product.name,
+            "category": product.category, "description": product.blurb or "", "image_url": product.image_url,
+            "variants": variants, "currency": "BDT", "delivery_mode": config.delivery_mode,
+            "delivery_estimate": config.delivery_estimate, "delivery_note": config.delivery_note,
+            "purchase_terms": config.purchase_terms, "required_buyer_fields": config.required_buyer_fields,
+            "sales_enabled": config.sales_enabled, "selected": str(product.id) in selected})
+    return result
