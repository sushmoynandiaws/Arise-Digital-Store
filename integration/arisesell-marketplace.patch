diff --git a/backend/app/api/v1/marketplace.py b/backend/app/api/v1/marketplace.py
new file mode 100644
--- /dev/null
+++ b/backend/app/api/v1/marketplace.py
@@ -0,0 +1,427 @@
+"""Opt-in marketplace bridge; commerce remains authoritative in AriseSell."""
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import json
+import secrets
+import uuid
+from datetime import timedelta
+from urllib.parse import urlencode, urlsplit
+
+from fastapi import APIRouter, Depends, HTTPException, Request, Response
+from jose import JWTError, jwt
+from pydantic import BaseModel, ConfigDict, EmailStr, Field, TypeAdapter, field_validator
+from sqlalchemy import func, select
+from sqlalchemy.orm import selectinload
+
+from app.core.config import settings
+from app.core.database import get_db
+from app.core.deps import get_current_active_user, get_current_user_payload
+from app.core.redis import get_redis_client
+from app.models.channel import ConnectedChannel
+from app.models.commerce import CheckoutDraft
+from app.models.conversation import Conversation, Message
+from app.models.digital import DigitalStockUnit
+from app.models.order import Order
+from app.models.product import Product
+from app.models.tenant import Business
+from app.models.user import User
+from app.schemas.digital import AcceptRequest, PaymentProofRequest, QuoteRequest
+from app.services import digital_checkout as checkout
+from app.services.ai_quota_service import is_store_owner
+from app.services.digital_inventory import active_store, config_for, decrypt_stock, event, fingerprint, lock_business, receiving_accounts, utc, utcnow
+from app.services.session_service import require_active_session
+
+router = APIRouter(prefix="/marketplace", tags=["Arise Digital Store"])
+
+
+def configured():
+    uri = settings.MARKETPLACE_REDIRECT_URI
+    parsed = urlsplit(uri)
+    local = parsed.hostname in {"localhost", "127.0.0.1", "::1"}
+    if (len(settings.MARKETPLACE_BRIDGE_KEY) < 32 or not parsed.netloc or parsed.username or parsed.password
+            or parsed.query or parsed.fragment or parsed.path != "/api/auth/callback"
+            or not (parsed.scheme == "https" or parsed.scheme == "http" and local)):
+        raise HTTPException(503, "Arise Digital Store integration is not configured")
+
+
+def bridge(request: Request, response: Response):
+    response.headers["Cache-Control"] = "no-store"
+    configured()
+    supplied = request.headers.get("X-Marketplace-Key", "")
+    if not hmac.compare_digest(supplied.encode(), settings.MARKETPLACE_BRIDGE_KEY.encode()):
+        raise HTTPException(401, "Marketplace service authentication is required")
+
+
+class Input(BaseModel):
+    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True, hide_input_in_errors=True)
+
+
+class Authorization(Input):
+    state: str = Field(min_length=32, max_length=128, pattern=r"^[A-Za-z0-9_-]+$")
+    code_challenge: str = Field(min_length=43, max_length=43, pattern=r"^[A-Za-z0-9_-]+$")
+    redirect_uri: str = Field(max_length=2000)
+
+
+class Exchange(Input):
+    code: str = Field(min_length=32, max_length=256)
+    code_verifier: str = Field(min_length=43, max_length=128, pattern=r"^[A-Za-z0-9._~-]+$")
+    redirect_uri: str = Field(max_length=2000)
+
+
+class Listing(Input):
+    published: bool
+    name: str = Field(min_length=2, max_length=100)
+    description: str = Field(min_length=10, max_length=1500)
+    support: str = Field(default="", max_length=255)
+    logo_url: str = Field(default="", max_length=2000)
+    cover_url: str = Field(default="", max_length=2000)
+    product_ids: list[uuid.UUID] = Field(max_length=500)
+
+    @field_validator("support")
+    @classmethod
+    def public_support(cls, value):
+        import re
+        if not value or re.fullmatch(r"[^\s@]+@[^\s@]+\.[^\s@]+", value):
+            return value
+        parsed = urlsplit(value)
+        if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
+            raise ValueError("Use a support email address or HTTPS website")
+        return value
+
+    @field_validator("logo_url", "cover_url")
+    @classmethod
+    def public_image(cls, value):
+        if value:
+            url = urlsplit(value)
+            if url.scheme != "https" or not url.hostname or url.username or url.password:
+                raise ValueError("Use an HTTPS image URL without credentials")
+        return value
+
+
+class BuyerFields(Input):
+    name: str = Field(min_length=1, max_length=100)
+    email: str = Field(default="", max_length=255)
+    phone: str = Field(default="", max_length=32)
+
+    @field_validator("email")
+    @classmethod
+    def email_address(cls, value):
+        return str(TypeAdapter(EmailStr).validate_python(value)) if value else value
+
+
+class MarketQuote(QuoteRequest):
+    shop_id: uuid.UUID
+    buyer: BuyerFields
+
+
+class MarketAccept(AcceptRequest):
+    shop_id: uuid.UUID
+    product_id: uuid.UUID
+    draft_id: uuid.UUID
+
+
+@router.post("/authorize")
+async def authorize(req: Authorization, response: Response, user=Depends(get_current_active_user),
+                    payload=Depends(get_current_user_payload)):
+    configured()
+    response.headers["Cache-Control"] = "no-store"
+    if req.redirect_uri != settings.MARKETPLACE_REDIRECT_URI:
+        raise HTTPException(400, "This marketplace redirect is not registered")
+    code = secrets.token_urlsafe(32)
+    redis = await get_redis_client()
+    await redis.set("marketplace:code:" + fingerprint(code), json.dumps({"sub": str(user.id), "sid": payload["sid"],
+        "challenge": req.code_challenge, "redirect_uri": req.redirect_uri}), ex=180)
+    return {"redirect": req.redirect_uri + "?" + urlencode({"code": code, "state": req.state})}
+
+
+@router.post("/token", dependencies=[Depends(bridge)])
+async def exchange(req: Exchange, db=Depends(get_db)):
+    if req.redirect_uri != settings.MARKETPLACE_REDIRECT_URI:
+        raise HTTPException(400, "This marketplace redirect is not registered")
+    redis = await get_redis_client()
+    raw = await redis.getdel("marketplace:code:" + fingerprint(req.code))
+    if not raw:
+        raise HTTPException(400, "Authorization code expired or has already been used")
+    data = json.loads(raw)
+    challenge = base64.urlsafe_b64encode(hashlib.sha256(req.code_verifier.encode()).digest()).decode().rstrip("=")
+    if not hmac.compare_digest(challenge, data["challenge"]) or data["redirect_uri"] != req.redirect_uri:
+        raise HTTPException(400, "Authorization proof does not match")
+    await require_active_session(db, data)
+    claims = {"sub": data["sub"], "sid": data["sid"], "aud": "arise-digital-store", "type": "marketplace",
+        "exp": utcnow() + timedelta(hours=12)}
+    return {"access_token": jwt.encode(claims, settings.JWT_SECRET_KEY, algorithm=settings.JWT_ALGORITHM), "expires_in": 43200}
+
+
+async def market_user(request: Request, db=Depends(get_db)):
+    authorization = request.headers.get("Authorization", "")
+    if not authorization.startswith("Bearer "):
+        raise HTTPException(401, "Continue with AriseSell to sign in")
+    try:
+        data = jwt.decode(authorization[7:], settings.JWT_SECRET_KEY, algorithms=[settings.JWT_ALGORITHM], audience="arise-digital-store")
+        if data.get("type") != "marketplace":
+            raise ValueError
+        user_id = uuid.UUID(data["sub"])
+    except (JWTError, ValueError, KeyError, TypeError):
+        raise HTTPException(401, "Marketplace sign-in expired; continue with AriseSell again") from None
+    await require_active_session(db, data)
+    user = await db.get(User, user_id)
+    if not user or not user.is_active or not user.is_verified or user.scheduled_deletion_at:
+        raise HTTPException(403, "This AriseSell account is unavailable")
+    return user
+
+
+async def optional_user(request: Request, db=Depends(get_db)):
+    return await market_user(request, db) if request.headers.get("Authorization") else None
