{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "rust",
      "entrypoint": "api/app.rs",
      "devCommand": "cargo run --locked --bin arise-digital-store",
      "routes": [{ "src": "/(.*)", "dest": "/index" }]
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    }
  },
  "headers": [
    { "source": "/assets/:file", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api", "destination": { "service": "app" } },
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/health", "destination": { "service": "app" } },
    { "source": "/shops/:slug/products/:product", "destination": { "service": "app" } },
    { "source": "/shops/:slug", "destination": { "service": "app" } },
    { "source": "/products/:id", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
