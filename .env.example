# Copy to .env and set private values. scripts/setup.py creates a LOCAL DEMO configuration instead.
PUBLIC_ORIGIN=https://digital.example.com
ARISESELL_API_URL=https://arisesell.com/api/v1
ARISESELL_WEB_URL=https://arisesell.com
ARISESELL_BRIDGE_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_KEY_AT_LEAST_32_CHARACTERS
# base64url encoding of 32 random bytes, without padding. Do not rotate without migrating stored sessions.
SESSION_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64URL_KEY
DEMO_MODE=false
BIND_ADDRESS=0.0.0.0:8088
DATABASE_PATH=data/marketplace.db
